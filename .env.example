# ==============================================================================
# TrucnksCISCO - Environment Configuration Template
# ==============================================================================
# Copia este archivo a .env y completa los valores con tus credenciales seguras.
# NUNCA compartas tu archivo .env ni subas tokens en texto plano a repositorios.

# Puerto del Servidor Puente para Cisco Packet Tracer
PORT=7531
NODE_ENV=development

# Repositorio Remoto
GITHUB_REPO_OWNER=YvnPretty
GITHUB_REPO_NAME=TrucnksCISCO

# Token de Acceso Personal de GitHub (PAT)
# Genera un nuevo token seguro en: https://github.com/settings/tokens
# Asigna permisos 'repo' exclusivamente.
GITHUB_PAT=tu_nuevo_token_aqui
